# =============================================================================
# Makefile for the NORMAL diffusion space-time FOM (NO ROM / NO POD)
#
# Spatial MPI partition + temporal block DOFs on every spatial node.
# Supported time discretizations: dG(0), dG(1), dG(2).
#
# Examples:
#   make -f Makefile_ST clean
#   make -f Makefile_ST ST_DEGREE=0 ST_SLABS_PER_WINDOW=4
#   make -f Makefile_ST ST_DEGREE=1 ST_SLABS_PER_WINDOW=4
#   make -f Makefile_ST ST_DEGREE=2 ST_SLABS_PER_WINDOW=4
#
# Runtime:
#   mpirun -np 4 ./diff_ST_MPI ./ -nd 4 -nm 10 -pa 8 -st 0
#
# Runtime overrides:
#   ST_FOM_TIME_DEGREE=1
#   ST_FOM_SLABS_PER_WINDOW=4
#   ST_FOM_ACCURACY_CSV=st_accuracy.csv
# =============================================================================

CC = mpic++
FC = mpif90

CFLAGS  := -g -O3 -ffunction-sections -fdata-sections
LDFLAGS :=

ST_DEGREE          ?= 1
ST_SLABS_PER_WINDOW ?= 4

# If your local convection-diffusion preprocessing helpers use different names,
# override these on make command line.
ST_CONVDIFF_PRE      ?= BBFE_convdiff_pre
ST_CONVDIFF_FINALIZE ?= BBFE_convdiff_finalize

CFLAGS += \
        -DSTSB_DEGREE=$(ST_DEGREE) \
        -DSTSB_NUM_WINDOW_SLABS=$(ST_SLABS_PER_WINDOW) \
        -DST_FOM_CONVDIFF_PRE=$(ST_CONVDIFF_PRE) \
        -DST_FOM_CONVDIFF_FINALIZE=$(ST_CONVDIFF_FINALIZE)

UNAME_S := $(shell uname -s)

ifeq ($(UNAME_S),Darwin)
DEAD_STRIP_FLAG := -Wl,-dead_strip
GROUP_BEGIN :=
GROUP_END :=
else
DEAD_STRIP_FLAG := -Wl,--gc-sections
GROUP_BEGIN := -Wl,--start-group
GROUP_END := -Wl,--end-group
endif

TEST_THERMAL_ROOT ?= ../../../test_thermal
MONOLIS_ROOT      ?= $(TEST_THERMAL_ROOT)/submodule/monolis
ROM_ROOT          ?= ../..

INCLUDES_ROM := \
        -I$(ROM_ROOT)/include/rom_BB \
        -I$(ROM_ROOT)/include/rom_std \
        -I$(ROM_ROOT)/include/rom_sys \
        -I$(ROM_ROOT)/include/rom_ecm

INCLUDES := \
        -I/usr/local/include \
        -I$(MONOLIS_ROOT)/include \
        -I$(TEST_THERMAL_ROOT)/include \
        $(INCLUDES_ROM) \
        -I./diff_core

LIBS_BB := \
        -L$(TEST_THERMAL_ROOT)/lib \
        -lBBFE_std \
        -lBBFE_sys \
        -lBBFE_elemmat \
        -lBBFE_manusol \
        -lBB

LIBS_ROM := \
        -L$(ROM_ROOT)/lib \
        -lrom_BB \
        -lrom_std \
        -lrom_sys \
        -lrom_ecm

LIBS_NUMERIC := -llapack -lblas

LIBS_MONOLIS := \
        -L/usr/local/lib \
        -lm \
        -lstdc++ \
        -L$(MONOLIS_ROOT)/lib \
        -lmonolis_solver \
        -lgedatsu \
        -lmonolis_utils \
        -lmetis

TARGET := diff_ST_MPI

ST_FOM_COMMON_PARTS := $(wildcard ./diff_core/st_fom_common/*.inc)

OBJ := \
        ./diff_core/convdiff_core.o \
        ./diff_core/core_FOM.o \
        ./diff_core/st_fom_common.o \
        ./diff_core/core_FOM_ST_spaceblock.o \
        ./diff_core/st_fom_project_adapter.o \
        ./diff_main/ST_FOM/main_ST_FOM.o

.PHONY: all build clean print_config

all: $(TARGET)
build: $(TARGET)

$(TARGET): $(OBJ)
	$(FC) $(CFLAGS) $(LDFLAGS) $(DEAD_STRIP_FLAG) \
		-o $@ $(OBJ) \
		$(GROUP_BEGIN) $(LIBS_BB) $(LIBS_ROM) $(LIBS_MONOLIS) $(LIBS_NUMERIC) $(GROUP_END)
	@echo
	@echo "Built normal ST-FOM: $(TARGET)"
	@echo "  ST degree     : dG($(ST_DEGREE))"
	@echo "  slabs/window  : $(ST_SLABS_PER_WINDOW)"
	@echo "  ROM/POD       : disabled (ROM common libraries linked for shared project definitions)"
	@echo

./diff_core/convdiff_core.o: \
        ./diff_core/convdiff_core.c \
        ./diff_core/convdiff_core.h
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

# core_FOM.h pulls in the existing ROM/common dataset headers.  The normal
# ST-FOM does not perform reduction, but it reuses FE_SYSTEM and project-common
# definitions from this layer.  Keep function/data sections so unused legacy
# ROM routines can be discarded by --gc-sections.
./diff_core/core_FOM.o: \
        ./diff_core/core_FOM.c \
        ./diff_core/core_FOM.h \
        ./diff_core/diff_dataset.h \
        ./diff_core/convdiff_core.h
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

./diff_core/st_fom_common.o: \
        ./diff_core/st_fom_common.c \
        ./diff_core/st_fom_common.h \
        $(ST_FOM_COMMON_PARTS)
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

./diff_core/core_FOM_ST_spaceblock.o: \
        ./diff_core/core_FOM_ST_spaceblock.c \
        ./diff_core/core_FOM_ST_spaceblock.h \
        ./diff_core/core_FOM.h \
        ./diff_core/st_fom_common.h
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

./diff_core/st_fom_project_adapter.o: \
        ./diff_core/st_fom_project_adapter.c \
        ./diff_core/st_fom_project_adapter.h \
        ./diff_core/core_FOM.h
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

./diff_main/ST_FOM/main_ST_FOM.o: \
        ./diff_main/ST_FOM/main_ST_FOM.c \
        ./diff_core/core_FOM_ST_spaceblock.h \
        ./diff_core/st_fom_project_adapter.h
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

print_config:
	@echo "CC                   = $(CC)"
	@echo "FC                   = $(FC)"
	@echo "TARGET               = $(TARGET)"
	@echo "ST_DEGREE            = $(ST_DEGREE)"
	@echo "ST_SLABS_PER_WINDOW  = $(ST_SLABS_PER_WINDOW)"
	@echo "ST_CONVDIFF_PRE       = $(ST_CONVDIFF_PRE)"
	@echo "ST_CONVDIFF_FINALIZE  = $(ST_CONVDIFF_FINALIZE)"
	@echo "TEST_THERMAL_ROOT    = $(TEST_THERMAL_ROOT)"
	@echo "MONOLIS_ROOT         = $(MONOLIS_ROOT)"
	@echo "ROM_ROOT             = $(ROM_ROOT)"
	@echo "INCLUDES_ROM         = $(INCLUDES_ROM)"
	@echo "LIBS_ROM             = $(LIBS_ROM)"

clean:
	$(RM) -f $(OBJ) $(TARGET)
